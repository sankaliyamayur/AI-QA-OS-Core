<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aiqaos</groupId>
        <artifactId>ai-qa-os</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-qa-os-dashboard</artifactId>
    <packaging>jar</packaging>

    <name>AI-QA-OS Dashboard</name>
    <description>Dashboard module for AI-QA-OS</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring Boot 4: RestTemplateBuilder and the client HTTP factory API moved out of
             spring-boot-starter-web into this module; SEC-6 (ADR-091/093) builds the gateway client
             from them, so it must be declared explicitly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Internal module dependencies -->
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- FI-ENT5-C (ADR-073): serve the durable artifact copy from ArtifactStore (keyFor from
             FI-ENT5-A). Explicit dep — the dashboard now directly uses execution's ArtifactStore. -->
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-execution</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-orchestration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          LRN-3 (FI-LRN3-A): the learning read-model. Already on the classpath transitively via
          orchestration (which calls LearningObservationRecorder), but the dashboard compiles against
          these types directly, so declare it rather than depend on someone else's dependency.
        -->
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-learning</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- PE-3: aggregate persisted eval results into the prompt-quality read-model (ADR-062). -->
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-eval</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- FI-PE3-C: read prompt_executions for the per-execution prompt history read-model. -->
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-intelligence</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- FI-PE3-D: push prompt-regression alerts through ENT-2's governed notification path. -->
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-notification</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ENT-5 (ADR-068): opt into the S3/MinIO object store so ArtifactController#serveFromStore
             (/api/artifacts/store/**) can resolve durable artifacts. Execution declares the AWS SDK
             <optional> (non-transitive); the serving app must opt in. Versions from the awssdk BOM. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4:  moved out of spring-boot-starter-test into its own slice module -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Copies the repo's shared Flyway migrations onto this module's classpath at
                 db/migration (Flyway's default classpath scan location), avoiding a runtime
                 filesystem: path that would be fragile relative to the process working directory. -->
            <resource>
                <directory>../deployment/migration/db/migration</directory>
                <targetPath>db/migration</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

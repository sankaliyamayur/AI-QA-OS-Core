<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aiqaos</groupId>
        <artifactId>ai-qa-os</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-qa-os-gateway</artifactId>
    <packaging>jar</packaging>

    <name>ai-qa-os-gateway</name>

    <dependencies>
        <!-- Spring MVC Stack (replaces reactive Spring Cloud Gateway) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- WebSocket STOMP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Actuator for health -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- OpenAPI / Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>
        <!-- Internal module dependencies -->
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-tenant</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-brain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-agents-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-orchestration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-execution</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-reporting</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- OBS-1: TracingFilter uses TraceContextPropagator directly (was transitive via orchestration). -->
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-observability</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-ai-provider</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- PostgreSQL and Spring Data JPA dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- SCALE-2 (ADR-064): opt in to the distributed EventBus. Provides KafkaTemplate + autoconfig so
             core's KafkaEventBus activates when aiqaos.events.transport=kafka; default stays in-process. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- ENT-5 (ADR-068): opt in to the durable S3/MinIO artifact object store. The gateway runs the
             ExecutionStep that uploads produced artifacts; execution declares these as optional (non-
             transitive), so the app must opt in for S3Client to be present. S3ObjectStorageClient +
             S3StorageConfiguration then activate on aiqaos.artifacts.store=object & object.provider=s3;
             default (local / in-memory) is unchanged. Versions from the awssdk BOM. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ADR-089: in-memory DB so GatewayApplicationContextSmokeTest can start the real context
             without a Postgres. Schema comes from ddl-auto in that test, not Flyway. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Copies the repo's shared Flyway migrations onto this module's classpath at
                 db/migration (Flyway's default classpath scan location), same as ai-qa-os-dashboard. -->
            <resource>
                <directory>../deployment/migration/db/migration</directory>
                <targetPath>db/migration</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aiqaos</groupId>
        <artifactId>ai-qa-os</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-qa-os-core</artifactId>
    <packaging>jar</packaging>

    <name>ai-qa-os-core</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Jackson 3 (Spring Boot 4). The groupId moved com.fasterxml.jackson.* -> tools.jackson.*;
             annotations are the exception and remain under com.fasterxml.jackson.annotation, pulled
             in transitively by databind. jackson-datatype-jsr310 is gone: java.time support is built
             into Jackson 3's databind, so JavaTimeModule no longer exists and must not be registered. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- SCALE-2 (ADR-064): distributed EventBus binding. Optional — not transitive, so modules that
             don't opt in carry zero Kafka weight; KafkaEventBus is @ConditionalOnClass(KafkaTemplate). -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Spring Boot 4 modularised autoconfiguration: spring-boot-autoconfigure no longer contains
             a single Kafka class, so KafkaTemplate is never auto-configured and the gateway fails to
             start with AIQAOS_EVENTS_TRANSPORT=kafka — "KafkaEventBus required a bean of type
             KafkaTemplate that could not be found". spring-kafka alone supplies the classes that
             satisfy @ConditionalOnClass but not the bean, so the whole suite stays green: every Kafka
             test mocks KafkaTemplate rather than auto-configuring one. Only a live run reaches this.

             Optional for the same reason as spring-kafka above. Same split as the test slices (see
             spring-boot-data-jpa-test in ai-qa-os-observability). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

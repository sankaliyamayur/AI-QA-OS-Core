# AI-QA-OS — required secret environment variables (SEC-2)
#
# Copy to a local .env (git-ignored) or inject via your secret store (K8s Secret / Vault / CI).
# This file documents the variables ONLY — it must never contain real secret values.
# No secret has a committed default: a missing required secret fails startup fast when
# security enforcement is on (aiqaos.security.enabled=true).

# --- Database (gateway :8082, dashboard :8090) ---
SPRING_DATASOURCE_USERNAME=postgres          # optional, defaults to "postgres"
SPRING_DATASOURCE_PASSWORD=                   # REQUIRED — no committed default

# --- Phase 1 local infrastructure (deployment/docker/docker-compose.yml) ---
# Local dev container creds. The Postgres password has a dev-only default in compose so
# `docker compose up` works out of the box; override here for anything shared. These are the
# vars the `compose` Spring profile reads when apps run locally against the containers.
POSTGRES_DB=ai_qa_os_dashboard               # canonical dev DB (both apps share this schema)
POSTGRES_USER=qaosuser
POSTGRES_PASSWORD=qaoslocaldev                # dev-only; override for shared environments
DB_URL=jdbc:postgresql://localhost:5432/ai_qa_os_dashboard?preferQueryMode=simple
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_HOST=localhost
QDRANT_PORT=6334
KAFKA_BOOTSTRAP=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin               # dev-only; override for shared environments

# --- JWT signing key (ai-qa-os-security) ---
# REQUIRED when aiqaos.security.enabled=true. Use a strong random value (>= 256 bits).
# When enforcement is off (local/test), a non-persistent ephemeral key is used if unset.
JWT_SECRET=

# --- Bootstrap admin (SEC-1) ---
# If set, an ADMIN user is auto-created on first startup when none exists.
AIQAOS_BOOTSTRAP_ADMIN_USERNAME=admin
AIQAOS_BOOTSTRAP_ADMIN_EMAIL=admin@aiqaos.local
AIQAOS_BOOTSTRAP_ADMIN_PASSWORD=

# --- Security enforcement toggle (SEC-1) ---
# true in real environments; set false for open local development.
AIQAOS_SECURITY_ENABLED=true

# --- LLM providers (already externalized via ApiKeyPool / SecretManager) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

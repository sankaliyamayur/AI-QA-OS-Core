<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aiqaos</groupId>
        <artifactId>ai-qa-os</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ai-qa-os-execution</artifactId>
    <packaging>jar</packaging>

    <name>ai-qa-os-execution</name>

    <dependencies>
        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.aiqaos</groupId>
            <artifactId>ai-qa-os-agents</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- SCALE-1 (ADR-065): distributed job queue over Redis Streams. Optional — not transitive, so
             modules that don't opt in carry no Redis weight; RedisStreamExecutionJobQueue is
             @ConditionalOnClass(StringRedisTemplate) + @ConditionalOnExpression(provider=redis). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- ENT-5 (ADR-068): real object-storage binding over the S3 API (MinIO today, AWS S3 later).
             Optional — not transitive, so modules that don't opt in carry no AWS weight;
             S3ObjectStorageClient is @ConditionalOnClass(S3Client) + @ConditionalOnExpression(provider=s3).
             url-connection-client is the minimal JDK-based sync HTTP client for the S3Client. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <!-- ORG-1: never bundle the vendored Playwright node_modules into the JAR.
                         It is restored on demand via `npm ci` from the committed package-lock.json. -->
                    <exclude>scripts/node_modules/**</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
